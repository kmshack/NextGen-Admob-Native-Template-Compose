<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#E8DEF8"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="AndroidView + Compose Test"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1D1B20" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This screen demonstrates loading Compose NativeAd components inside traditional Android Views using ComposeView."
                android:textSize="14sp"
                android:textColor="#49454F"
                android:layout_marginBottom="16dp" />

            <!-- Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/holo_blue_light"
                android:padding="12dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test Scenario"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View (XML) -> ComposeView -> NativeAd Compose Component -> AndroidViewBinding -> NativeAdView"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- CTR Optimized Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E8F5E9"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CTR Optimized Templates"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High-performance ad templates"
                    android:textColor="#388E3C"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Full Width Media Template Section (CTR+) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Width Media Template (CTR+)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1D1B20"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/fullWidthMediaAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="300dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/fullWidthMediaAdComposeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/fullWidthMediaAdProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Content Template Section (CTR+) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Content Template (CTR+)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1D1B20"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/contentAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="250dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/contentAdComposeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/contentAdProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- App Install Template Section (CTR+) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Install Template (CTR+)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1D1B20"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/appInstallAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="200dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/appInstallAdComposeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/appInstallAdProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Standard Templates Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard Templates"
                android:textStyle="bold"
                android:textColor="#49454F"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Headline Template Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Headline Template"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1D1B20"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/headlineAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="50dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/headlineAdComposeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/headlineAdProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Small Template Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Small Template"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1D1B20"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/smallAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="80dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/smallAdComposeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/smallAdProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Icon Small Template Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Icon Small Template"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1D1B20"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/iconSmallAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="80dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/iconSmallAdComposeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/iconSmallAdProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Medium Template Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medium Template"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1D1B20"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/mediumAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="200dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/mediumAdComposeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/mediumAdProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Large Template Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Large Template"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1D1B20"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/largeAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="300dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/largeAdComposeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/largeAdProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Status Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E7E0EC"
                android:padding="16dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#1D1B20" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading ads..."
                    android:textSize="12sp"
                    android:textColor="#49454F"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/round_chevron_right_24"
            android:rotation="180"
            android:tint="#333333" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="View Sample (NativeAdTemplateView)"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:text="Loading ads..."
        android:textColor="#666666"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CTR+ Optimized Templates Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="CTR+ Optimized Templates"
                android:textColor="#1976D2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Full Width Media Ad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Full Width Media"
                android:textColor="#666666"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <com.soosu.nextgen.admobnative.NativeAdTemplateView
                    android:id="@+id/ad_full_width"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:adTemplate="fullWidthMedia" />

                <ProgressBar
                    android:id="@+id/fullWidthAdProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="16dp" />

            </FrameLayout>

            <!-- Content Ad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Content Feed"
                android:textColor="#666666"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_corner_12dp"
                android:backgroundTint="#FFFFFF"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <com.soosu.nextgen.admobnative.NativeAdTemplateView
                    android:id="@+id/ad_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:adTemplate="content"
                    app:adBackgroundColor="#FFFFFF"
                    app:adTextColor="#222222"
                    app:adCtaButtonColor="#1976D2"
                    app:adCtaTextColor="#FFFFFF" />

                <ProgressBar
                    android:id="@+id/contentAdProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="16dp" />

            </FrameLayout>

            <!-- App Install Ad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="App Install"
                android:textColor="#666666"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_corner_12dp"
                android:backgroundTint="#FFFFFF"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <com.soosu.nextgen.admobnative.NativeAdTemplateView
                    android:id="@+id/ad_app_install"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:adTemplate="appInstall"
                    app:adBackgroundColor="#FFFFFF"
                    app:adTextColor="#222222"
                    app:adCtaButtonColor="#1976D2"
                    app:adCtaTextColor="#FFFFFF" />

                <ProgressBar
                    android:id="@+id/appInstallAdProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="16dp" />

            </FrameLayout>

            <!-- Standard Templates Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Standard Templates"
                android:textColor="#1976D2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Headline Ad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Headline"
                android:textColor="#666666"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_corner_12dp"
                android:backgroundTint="#FFFFFF"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <com.soosu.nextgen.admobnative.NativeAdTemplateView
                    android:id="@+id/ad_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:adTemplate="headline"
                    app:adBackgroundColor="#FFFFFF"
                    app:adTextColor="#222222" />

                <ProgressBar
                    android:id="@+id/headlineAdProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="16dp" />

            </FrameLayout>

            <!-- Small Ad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Small"
                android:textColor="#666666"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_corner_12dp"
                android:backgroundTint="#FFFFFF"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <com.soosu.nextgen.admobnative.NativeAdTemplateView
                    android:id="@+id/ad_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:adTemplate="small"
                    app:adBackgroundColor="#FFFFFF"
                    app:adTextColor="#222222" />

                <ProgressBar
                    android:id="@+id/smallAdProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="16dp" />

            </FrameLayout>

            <!-- Icon Small Ad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Icon Small"
                android:textColor="#666666"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_corner_12dp"
                android:backgroundTint="#FFFFFF"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <com.soosu.nextgen.admobnative.NativeAdTemplateView
                    android:id="@+id/ad_icon_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:adTemplate="iconSmall"
                    app:adBackgroundColor="#FFFFFF"
                    app:adTextColor="#222222" />

                <ProgressBar
                    android:id="@+id/iconSmallAdProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="16dp" />

            </FrameLayout>

            <!-- Medium Ad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Medium"
                android:textColor="#666666"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_corner_12dp"
                android:backgroundTint="#FFFFFF"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <com.soosu.nextgen.admobnative.NativeAdTemplateView
                    android:id="@+id/ad_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:adTemplate="medium"
                    app:adBackgroundColor="#FFFFFF"
                    app:adTextColor="#222222" />

                <ProgressBar
                    android:id="@+id/mediumAdProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="16dp" />

            </FrameLayout>

            <!-- Large Ad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Large"
                android:textColor="#666666"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/rounded_corner_12dp"
                android:backgroundTint="#FFFFFF"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <com.soosu.nextgen.admobnative.NativeAdTemplateView
                    android:id="@+id/ad_large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:adTemplate="large"
                    app:adBackgroundColor="#FFFFFF"
                    app:adTextColor="#222222"
                    app:adCtaButtonColor="#1976D2"
                    app:adCtaTextColor="#FFFFFF" />

                <ProgressBar
                    android:id="@+id/largeAdProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="16dp" />

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
